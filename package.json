{
  "name": "ai-interview-prep",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered mock interview, assessment and coding practice platform",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "smoke:live": "tsx scripts/live-turn-control-smoke.ts",
    "smoke:ai": "tsx scripts/smoke-real-ai.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "e2e:interview": "tsx scripts/e2e-text-interview.ts",
    "harness:speech": "tsx scripts/live-speech-harness.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
