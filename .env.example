# =============================================================================
# AI Interview Prep — environment template
# Copy to `.env` and fill in. NEVER commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE  (REQUIRED — the app will not start without it)
# -----------------------------------------------------------------------------
# Any PostgreSQL 13+ instance: local, Docker, Neon, Supabase, Railway…
# Local example:  postgresql://postgres:postgres@localhost:5432/ai_interview_prep
# Neon example:   postgresql://user:pass@ep-x.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_interview_prep?schema=public"

# -----------------------------------------------------------------------------
# AUTH  (REQUIRED)
# -----------------------------------------------------------------------------
# Signing secret for the JWT session cookie.
# Generate with:  npx auth secret     (or)  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Canonical origin. Required in production; optional locally.
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Comma-separated emails auto-promoted to ADMIN at registration.
# Leave empty to grant admin manually (see README → Creating an admin).
# Set to "false" to skip the demo accounts the seed would otherwise create.
# They are skipped automatically when NODE_ENV=production.
SEED_DEMO_USERS=true

ADMIN_EMAILS=""

# -----------------------------------------------------------------------------
# AI PROVIDER  (REQUIRED for interviews / resume analysis / JD analysis)
# -----------------------------------------------------------------------------
# Without a key: the app still runs and every non-AI feature works; AI routes
# return a clear "AI is not configured" state instead of fake data.
#
# Pick ONE provider. Only that provider's key is required — the other can stay
# empty. There is no automatic fallback between them (see README → AI setup):
# silently switching providers on an error could start billing a paid account.
#
#   "gemini"    — Google Gemini. Has a free tier, so it is the default here.
#   "anthropic" — Anthropic Claude. Requires billing on your account.
AI_PROVIDER="gemini"

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Anthropic key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Model id. Leave EMPTY to use the documented default for the chosen provider:
#   gemini    → gemini-2.5-flash
#   anthropic → claude-opus-5
# Check current model names and free-tier limits before overriding:
#   https://ai.google.dev/gemini-api/docs/models
#   https://ai.google.dev/gemini-api/docs/rate-limits
AI_MODEL=""

# Realtime voice interview (Gemini Live). Leave EMPTY for the documented
# default, gemini-2.5-flash-native-audio-latest. Only Live-capable models work
# here — check which your key can reach before overriding:
#   https://ai.google.dev/gemini-api/docs/live
# Voice interviews require AI_PROVIDER="gemini"; there is no Anthropic
# equivalent, and the text interview remains available either way.
AI_LIVE_MODEL=""

# low | medium | high | xhigh | max — trades latency/cost against depth.
# On Gemini this maps onto the thinking budget: "low" disables thinking for a
# responsive interview turn; anything higher lets the model decide.
AI_EFFORT="low"

# -----------------------------------------------------------------------------
# FILE STORAGE  (resume PDFs — never stored in Postgres)
# -----------------------------------------------------------------------------
# "local" writes to ./storage (default, zero setup, good for dev + viva demo).
# "s3" uses any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, Backblaze).
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./storage"

# Only needed when STORAGE_PROVIDER="s3"
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Set for R2/MinIO/other non-AWS endpoints, e.g.
# https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=""

# -----------------------------------------------------------------------------
# CODE EXECUTION  (coding assessments)
# -----------------------------------------------------------------------------
# User code is NEVER executed inside this Next.js server.
# "judge0"   — self-hosted or RapidAPI-hosted Judge0 sandbox (recommended)
# "disabled" — editor + submission history still work; Run/Submit returns a
#              clear "code execution is not configured" state.
CODE_EXECUTION_PROVIDER="disabled"

# Self-hosted Judge0 (docker compose):  http://localhost:2358
# RapidAPI Judge0:  https://judge0-ce.p.rapidapi.com
JUDGE0_URL=""
# Only for RapidAPI-hosted Judge0
JUDGE0_API_KEY=""
JUDGE0_API_HOST="judge0-ce.p.rapidapi.com"

# -----------------------------------------------------------------------------
# VOICE INTERVIEWS  (optional — speech-to-text + text-to-speech)
# -----------------------------------------------------------------------------
# Without these the interview still works fully in text mode. The microphone
# and "read the question aloud" controls are hidden and the API returns a clear
# "voice is not configured" state. A transcript is NEVER fabricated.
#
# Speech-to-text: "deepgram" | "whisper" | "disabled"
#   deepgram — returns word-level timings, so pause analysis is available
#   whisper  — OpenAI Whisper API; no word timings, so pause metrics are
#              reported as unavailable rather than guessed
VOICE_STT_PROVIDER="disabled"
VOICE_STT_API_KEY=""
# Override only for self-hosted / proxied endpoints.
VOICE_STT_BASE_URL=""

# Text-to-speech: "elevenlabs" | "disabled"
VOICE_TTS_PROVIDER="disabled"
VOICE_TTS_API_KEY=""

# -----------------------------------------------------------------------------
# RATE LIMITING (optional)
# -----------------------------------------------------------------------------
# In-memory limiter is used by default (fine for a single instance).
RATE_LIMIT_AI_PER_MINUTE="12"
RATE_LIMIT_UPLOAD_PER_HOUR="10"
# Per-user daily ceiling across every AI feature — the cost brake.
RATE_LIMIT_AI_PER_DAY="200"

# -----------------------------------------------------------------------------
# LIMITS (optional — cost and abuse control)
# -----------------------------------------------------------------------------
# Hard ceiling on interview turns, independent of the requested question count.
MAX_INTERVIEW_TURNS="20"
# Characters of context sent to the model in a single call. Long resumes and
# transcripts are truncated to this before they reach a prompt.
MAX_AI_CONTEXT_CHARS="60000"
